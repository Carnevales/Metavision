--- !u!114 &156386002
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 156386000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 39aa3b9cf22cc874585d4d86eff2dd6d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TeatroSESI.MuseumPoint
  action: 2
  title: "Maracannes 1 \u2014 A origem do festival"
  body: "O primeiro Maracannes teve como principal objetivo a produ\xE7\xE3o e a
    exibi\xE7\xE3o de curtas-metragens baseados em releituras de filmes, com trabalhos
    apresentados em portugu\xEAs e ingl\xEAs. A proposta era incentivar os estudantes
    a explorar o universo cinematogr\xE1fico, reinterpretar hist\xF3rias conhecidas
    e desenvolver habilidades de cria\xE7\xE3o, atua\xE7\xE3o, roteiro e produ\xE7\xE3o
    audiovisual.\n\nEssa primeira edi\xE7\xE3o estabeleceu a base do festival, colocando
    os alunos como protagonistas de suas pr\xF3prias produ\xE7\xF5es e criando um
    espa\xE7o para compartilhar suas interpreta\xE7\xF5es do cinema."
  source: "Texto hist\xF3rico fornecido pelo respons\xE1vel pelo projeto."
  image: {fileID: 0}
  photoRegion:
    serializedVersion: 2
    x: 0
    y: 0
    width: 1
    height: 1
  credit: 
  radius: 2.3
