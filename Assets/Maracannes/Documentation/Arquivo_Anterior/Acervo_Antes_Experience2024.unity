  m_Script: {fileID: 11500000, guid: 39aa3b9cf22cc874585d4d86eff2dd6d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TeatroSESI.MuseumPoint
  action: 2
  title: "Maracannes 3 \u2014 Uma nova fase"
  body: "A partir do Maracannes 3, o festival passou por uma virada de chave em seu
    formato, adotando uma proposta tem\xE1tica para cada edi\xE7\xE3o. Essa mudan\xE7a
    ampliou as possibilidades criativas do evento, permitindo que os estudantes desenvolvessem
    produ\xE7\xF5es e apresenta\xE7\xF5es a partir de um conceito central diferente
    a cada ano.\n\nEssa nova fase come\xE7ou com o Maracannes Experience, inaugurando
    uma proposta que aproximou ainda mais o festival de experi\xEAncias art\xEDsticas
    diversificadas, ampliando seu espa\xE7o para al\xE9m das releituras cinematogr\xE1ficas."
  source: "Texto hist\xF3rico fornecido pelo respons\xE1vel pelo projeto."
  image: {fileID: 0}
  photoRegion:
    serializedVersion: 2
    x: 0
    y: 0
    width: 1
    height: 1
  credit: 
  radius: 2.3
