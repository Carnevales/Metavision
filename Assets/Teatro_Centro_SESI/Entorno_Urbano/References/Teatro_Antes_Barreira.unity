  m_Script: {fileID: 11500000, guid: 39aa3b9cf22cc874585d4d86eff2dd6d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TeatroSESI.MuseumPoint
  action: 2
  title: "01 \xB7 A sede e a cidade"
  body: "O Centro Empresarial Arthur Jo\xE3o Donato foi inaugurado em 12 de setembro
    de 1994. A nova sede ampliou o espa\xE7o das entidades da Firjan e sua integra\xE7\xE3o.
    Esta maquete representa o percurso p\xFAblico do teatro; as \xE1reas sem fotografias
    foram interpretadas."
  source: "Firjan \xB7 Carta da Ind\xFAstria, 'Trinta anos da Firjan Sede' (2024,
    atualiza\xE7\xE3o 2025)\ncartadaindustria.firjan.com.br/publicacoes/trinta-anos-da-firjan-sede"
  image: {fileID: 2800000, guid: 0b479555852312947ada76591accd97d, type: 3}
  photoRegion:
    serializedVersion: 2
    x: 0
    y: 0
    width: 1
    height: 1
  credit: "Fachada do teatro \xB7 foto fornecida pelo usu\xE1rio.\nRegistro contempor\xE2neo."
  radius: 1.9
