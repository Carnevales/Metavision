  m_Script: {fileID: 11500000, guid: 39aa3b9cf22cc874585d4d86eff2dd6d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TeatroSESI.MuseumPoint
  action: 2
  title: "02 \xB7 SESI: educa\xE7\xE3o e cultura"
  body: "Criado em 1946, o Servi\xE7o Social da Ind\xFAstria desenvolve a\xE7\xF5es
    de educa\xE7\xE3o, sa\xFAde e cultura para trabalhadores da ind\xFAstria e seus
    dependentes. O museu apresenta um recorte dessa atua\xE7\xE3o por meio do teatro
    e de seus espa\xE7os de encontro."
  source: "Firjan \xB7 Mem\xF3ria da Ind\xFAstria, 'A cria\xE7\xE3o do SESI'\nmemoriadaindustria.firjan.com.br/linha-do-tempo/industrias-base/criacao-do-sesi-nova-instituicao-de-apoio-ao-trabalhador"
  image: {fileID: 2800000, guid: 0b479555852312947ada76591accd97d, type: 3}
  photoRegion:
    serializedVersion: 2
    x: 0.16
    y: 0.08
    width: 0.72
    height: 0.56
  credit: "Entrada e programa\xE7\xE3o cultural \xB7 detalhe da foto do usu\xE1rio.\nRegistro
    contempor\xE2neo."
  radius: 1.9
