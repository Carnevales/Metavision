  m_Script: {fileID: 11500000, guid: 39aa3b9cf22cc874585d4d86eff2dd6d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TeatroSESI.MuseumPoint
  action: 2
  title: "04 \xB7 Dentro da caixa c\xEAnica"
  body: "A boca de cena \xE9 a abertura entre plateia e palco. No rider do Centro,
    ela mede 9,70 m de largura por 4,48 m de altura. O documento lista varas de ilumina\xE7\xE3o,
    refletores e equipamentos de \xE1udio. As cortinas e pernas delimitam a cena
    e escondem as \xE1reas laterais."
  source: "Firjan \xB7 Rider Teatro Firjan SESI Centro 2025, p\xE1gina 1\nRider_Centro_2025.pdf
    (References)"
  image: {fileID: 2800000, guid: 4987e2e8e1293774da61e65a736302f5, type: 3}
  photoRegion:
    serializedVersion: 2
    x: 0.15
    y: 0.38
    width: 0.7
    height: 0.48
  credit: "Cortinas, refletores e equipamentos \xB7 detalhe da foto do usu\xE1rio.\nRegistro
    contempor\xE2neo."
  radius: 1.9
